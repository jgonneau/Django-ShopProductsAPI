SECRET_KEY=your-secret-key-here

# environment variables
DJANGO_ENV=dev
DEBUG=True

# Production: comma-separated hostnames (used when DJANGO_ENV=prod)
# ALLOWED_HOSTS=example.com,www.example.com
# SECURE_SSL_REDIRECT=True
# JWT_AUTH_REFRESH_COOKIE=refresh_token
# JWT_AUTH_REFRESH_COOKIE_PATH=/api/user/token/refresh/
# JWT_AUTH_REFRESH_COOKIE_DOMAIN=.example.com
# JWT_AUTH_REFRESH_COOKIE_SAMESITE=Lax
# JWT_AUTH_REFRESH_COOKIE_SECURE=True

# PostgreSQL
POSTGRES_DB=shop_products
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
